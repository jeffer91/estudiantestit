{
  "name": "estudiantestit",
  "private": true,
  "version": "3.6.3",
  "type": "module",
  "main": "electron/administrador/main.cjs",
  "scripts": {
    "start": "electron .",
    "start:administrador": "electron .",
    "dev:ia": "node dev/ia-proxy-server.mjs",
    "build:github-pages": "node dev/preparar-github-pages.mjs",
    "build:estudiantes": "node dev/preparar-pages-estudiantes.mjs",
    "build:coordinadores": "node dev/preparar-pages-coordinadores.mjs",
    "build:investigadores": "node dev/preparar-pages-investigadores.mjs",
    "build:administrador": "node dev/preparar-pages-administrador.mjs",
    "check:syntax": "node dev/verificar-sintaxis.mjs",
    "check:apps": "node dev/verificar-apps.mjs",
    "check:compatibility": "node dev/verificar-compatibilidad-historial.mjs && node scripts/check-historical-compatibility.mjs && node scripts/check-returned-student-flow.mjs",
    "check:workflow": "node dev/verificar-flujo-investigacion.mjs",
    "check:quota": "node dev/verificar-cuota-firebase.mjs && node dev/verificar-batch-firestore.mjs && node dev/verificar-admin-v7.mjs",
    "check:outlook": "node dev/verificar-correo-outlook.mjs",
    "check:architecture": "node dev/verificar-arquitectura.mjs",
    "check:firebase-auth": "node dev/verificar-firebase-auth.mjs",
    "check:ia-completa": "node dev/verificar-ia-completa.mjs",
    "check:github-pages": "node dev/preparar-github-pages.mjs",
    "check:access": "node dev/verificar-logica-acceso.mjs",
    "check:apps-script": "node dev/verificar-apps-script.mjs",
    "check:admin": "node dev/verificar-admin-correccion-titulo.mjs && node dev/verificar-admin-envios-flexibles.mjs",
    "check:electron": "node dev/verificar-electron-administrador.mjs && node dev/verificar-admin-runtime.mjs",
    "check": "npm run check:syntax && npm run check:stats && npm run check:apps && npm run check:compatibility && npm run check:workflow && npm run check:quota && npm run check:outlook && npm run check:architecture && npm run check:firebase-auth && npm run check:ia-completa && npm run check:github-pages && npm run check:access && npm run check:apps-script && npm run check:admin && npm run check:electron",
    "check:stats": "node dev/verificar-estadisticas-minimal.mjs"
  },
  "devDependencies": {
    "electron": "43.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
